<?xml version="1.0" encoding="utf-8"?>
<!-- Wooden panel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:type="linear" android:centerY="0.3"
                android:startColor="#7A5639" android:centerColor="#5A3F2B" android:endColor="#3D2A1C" />
            <stroke android:width="2dp" android:color="#2A1D13" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- inset highlight along the top edge -->
    <item android:left="12dp" android:right="12dp" android:top="2dp" android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle"><solid android:color="#2EFFFFFF" /></shape>
    </item>
</layer-list>
