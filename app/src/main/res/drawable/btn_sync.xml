<?xml version="1.0" encoding="utf-8"?>
<!-- Gold Sync button with its darker bottom edge: .sync -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#6B4308" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFD768" android:endColor="#E9A92A" />
            <stroke android:width="1.5dp" android:color="#8A5A10" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
